{
  "name": "supaflare-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "dev:with-binding": "./scripts/dev-with-binding.sh",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-types": "openapi-typescript http://localhost:9999/openapi.json -o src/types/api.ts",
    "deploy": "pnpm run build && pnpm exec wrangler pages deploy dist",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "openapi-fetch": "^0.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.0",
    "wrangler": "^4.50.0"
  }
}
